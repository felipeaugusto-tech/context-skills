# TestRail bridge configuration.
#
# Copy to `.env` in this same directory and fill in. `.env` is gitignored —
# verify that before you save a real credential:
#     git check-ignore -v engine/mcp/testrail/.env
#
# Real environment variables override this file, so CI can inject a key from a
# secret store without anyone deleting their local copy.

# ---------------------------------------------------------------------------
# 1. Connection (required)
# ---------------------------------------------------------------------------
# The instance root. Not an API path — no /index.php, no /api/v2.
TESTRAIL_URL=https://accurate.testrail.io


# ---------------------------------------------------------------------------
# 2. Authentication — set EXACTLY ONE of the two blocks below
# ---------------------------------------------------------------------------

# (A) API key. The supported path; use this unless you cannot.
#     Generate under My Settings -> API Keys. Shown once, so copy it then.
#     The key inherits YOUR permissions, so a write made through it is
#     attributed to you. For shared or CI use, ask an admin for a service
#     account instead of sharing a personal key.
TESTRAIL_USER=you@accurate.com
TESTRAIL_API_KEY=

# (B) Session cookie. Only for an SSO-gated instance where no API key can be
#     minted. Copy the whole Cookie header from an authenticated browser
#     request (DevTools -> Network -> any request -> Request Headers -> Cookie).
#
#     Read the README's "Session cookie mode" section before relying on this:
#     the cookie expires, a logout invalidates it, and it is not a documented
#     interface, so TestRail may return an HTML login page instead of JSON at
#     any time. The bridge detects that and says so rather than guessing.
# TESTRAIL_SESSION_COOKIE=tr_session=...


# ---------------------------------------------------------------------------
# 3. Authorisation — every control fails closed
# ---------------------------------------------------------------------------

# "read" (default) or "write". In read mode the write tools are not registered
# at all, so the agent cannot call what it never sees.
TESTRAIL_MODE=read

# Project ids writes may touch. There is no wildcard. Empty = nothing is
# writable, even in write mode.
#
# Get the ids from `python server.py --probe`. Point this at a sandbox project
# first and only widen it once a real push has been reviewed — every write is
# resolved to its project and checked against this list before it is sent.
TESTRAIL_ALLOWED_PROJECTS=

# Register the delete tool at all. Deletes also need the per-call confirm
# phrase. TestRail deletions are not recoverable through the API.
TESTRAIL_ALLOW_DELETE=false

# Validate and echo writes without sending them. Leave this true for the first
# end-to-end run so you can inspect the exact payloads.
TESTRAIL_DRY_RUN=true


# ---------------------------------------------------------------------------
# 4. Tuning (optional — the defaults are fine)
# ---------------------------------------------------------------------------
# TESTRAIL_TIMEOUT=30
# TESTRAIL_MAX_RETRIES=4
# TESTRAIL_PAGE_SIZE=250
# Caps tool output to protect the agent's context window, not TestRail.
# TESTRAIL_MAX_RESPONSE_CHARS=60000
