# ---------------------------------------------------------------------------
# TestRail discovery / integration credentials -- EXAMPLE FILE
#
# Copy to `.env.testrail` (same directory), fill in the values, and keep it out
# of git. `.gitignore` covers `.env` and `.env.*` while explicitly allowing
# `*.example`, so this file is safe to commit and your populated copy is not.
#
#     cp engine/ci/.env.testrail.example engine/ci/.env.testrail
#
# IMPORTANT: `testrail_discovery.py` reads os.environ -- it does NOT parse this
# file. You must export the values into your shell first. See "Loading" below.
# ---------------------------------------------------------------------------


# --- Required ---------------------------------------------------------------

# Base URL of the instance. Scheme required, no trailing slash, no path.
# Must be https: the API key travels as an HTTP Basic Auth header, and the
# script refuses to follow any redirect that would downgrade to http.
TESTRAIL_URL=https://accurate.testrail.io

# Your TestRail login -- normally the email address you sign in with, NOT a
# display name or numeric user id.
TESTRAIL_USER=you@accurate.com

# API key generated under: TestRail -> My Settings -> API Keys.
# This is a password substitute, not a scoped token: it inherits *your* full
# permissions, so anything you can edit or delete, a script holding this key can
# edit or delete. Generate a dedicated key for this tool so it can be revoked
# without disturbing anything else.
#
# If requests come back 401/403, check in order:
#   1. the key was copied whole (they are long; truncation is the usual cause)
#   2. TESTRAIL_USER is the login email
#   3. the instance-wide toggle is on:
#      Administration -> Site Settings -> API -> Enable API   (needs an admin)
TESTRAIL_API_KEY=


# --- Loading ----------------------------------------------------------------
#
# bash / zsh / Git Bash / WSL -- export every variable in this file:
#
#     set -a && source engine/ci/.env.testrail && set +a
#     python3 engine/ci/testrail_discovery.py --probe
#
# PowerShell:
#
#     Get-Content engine/ci/.env.testrail |
#       Where-Object { $_ -match '^\s*[^#].*=' } |
#       ForEach-Object {
#         $name, $value = $_ -split '=', 2
#         [Environment]::SetEnvironmentVariable($name.Trim(), $value.Trim(), 'Process')
#       }
#     python engine/ci/testrail_discovery.py --probe
#
# Prefer a secret manager over a file on disk where one is available. In CI, set
# these as masked/protected variables -- never as plain pipeline variables, and
# never via `export TESTRAIL_API_KEY=...` on a command line, which lands the key
# in shell history and job logs.


# --- Variable-name compatibility --------------------------------------------
#
# The script also accepts the names used by the community TestRail MCP server,
# so one file can serve both if you later add that route. TESTRAIL_URL and
# TESTRAIL_USER take precedence if both spellings are set.
#
# TESTRAIL_INSTANCE_URL=https://accurate.testrail.io
# TESTRAIL_USERNAME=you@accurate.com


# --- Discovered ids (documentation only -- the script does NOT read these) ---
#
# Run `--probe` to list project ids, then record what you settle on here so the
# next person does not have to rediscover it. These are passed as CLI flags
# (`--project <id>`), not environment variables.
#
# TestRail project id(s) in scope:            e.g. --project 12
# Suite id(s) (multi-suite projects only):
# Section id(s) a push may write to:
#   ^ once a write path exists, this allowlist is the blast-radius control.
#     Nothing should be written outside it, and it belongs in
#     .cursor/skills/qa-test-case-writer/Context.md alongside the field map.
# Sandbox / throwaway project id for dry runs:
#   ^ get one before any write testing. The live instance is the system of
#     record for real projects; do not rehearse against it.
